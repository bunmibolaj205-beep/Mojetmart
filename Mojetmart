<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Trending Finds | Tech & Gadget Discoveries</title>

    <meta
        name="description"
        content="Discover trending tech, gadgets, accessories, smart home products, gaming gear, and creator tools worth checking out."
    >

    <meta
        name="keywords"
        content="tech gadgets, trending gadgets, tech accessories, gaming gadgets, smart home, creator gear, Amazon gadgets"
    >

    <meta name="author" content="Trending Finds">

    <meta property="og:title" content="Trending Finds | Tech & Gadgets">
    <meta
        property="og:description"
        content="Discover tech and gadgets worth knowing."
    >
    <meta property="og:type" content="website">

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header class="site-header">

        <div class="container header-inner">

            <a href="index.html" class="logo">
                Trending <span>Finds</span>
            </a>

            <button
                class="menu-toggle"
                id="menuToggle"
                aria-label="Open navigation menu"
                aria-expanded="false"
            >
                ☰
            </button>

            <nav class="main-nav" id="mainNav">

                <a href="index.html" class="active">Home</a>

                <a href="#categories">Categories</a>

                <a href="#trending">Trending</a>

                <a href="about.html">About</a>

                <a href="contact.html">Contact</a>

            </nav>

        </div>

    </header>


    <!-- ================= MAIN ================= -->

    <main>

        <!-- ================= HERO ================= -->

        <section class="hero">

            <div class="container hero-content">

                <div class="hero-text">

                    <span class="eyebrow">
                        TECH & GADGETS
                    </span>

                    <h1>
                        Discover the tech and gadgets worth knowing.
                    </h1>

                    <p>
                        Explore trending gadgets, useful tech accessories,
                        gaming gear, smart home devices, and creator tools
                        we think are worth checking out.
                    </p>

                    <div class="hero-buttons">

                        <a href="#trending" class="btn btn-primary">
                            Explore Trending Finds
                        </a>

                        <a href="#categories" class="btn btn-secondary">
                            Browse Categories
                        </a>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================= DISCLOSURE ================= -->

        <section class="affiliate-notice">

            <div class="container">

                <p>
                    <strong>Affiliate Disclosure:</strong>
                    Some links on Trending Finds may be affiliate links.
                    If you purchase through an eligible link, we may earn
                    a commission at no additional cost to you.
                </p>

                <a href="affiliate-disclosure.html">
                    Learn more
                </a>

            </div>

        </section>


        <!-- ================= SEARCH ================= -->

        <section class="search-section">

            <div class="container">

                <div class="section-heading">

                    <span class="eyebrow">
                        FIND YOUR NEXT GADGET
                    </span>

                    <h2>
                        What are you looking for?
                    </h2>

                </div>

                <div class="search-box">

                    <label for="searchInput" class="visually-hidden">
                        Search gadgets
                    </label>

                    <input
                        type="search"
                        id="searchInput"
                        placeholder="Search tech, gadgets, accessories..."
                        autocomplete="off"
                    >

                    <button
                        type="button"
                        id="searchButton"
                        aria-label="Search"
                    >
                        Search
                    </button>

                </div>

            </div>

        </section>


        <!-- ================= CATEGORIES ================= -->

        <section
            class="categories-section"
            id="categories"
        >

            <div class="container">

                <div class="section-heading">

                    <span class="eyebrow">
                        EXPLORE
                    </span>

                    <h2>
                        Browse Categories
                    </h2>

                    <p>
                        Find useful products based on what you're interested in.
                    </p>

                </div>


                <div class="category-grid">

                    <button
                        class="category-card"
                        data-category="Audio"
                    >

                        <span class="category-icon">
                            🎧
                        </span>

                        <h3>Audio</h3>

                        <p>
                            Headphones, earbuds and speakers.
                        </p>

                    </button>


                    <button
                        class="category-card"
                        data-category="Power"
                    >

                        <span class="category-icon">
                            🔋
                        </span>

                        <h3>Power</h3>

                        <p>
                            Chargers, power banks and useful accessories.
                        </p>

                    </button>


                    <button
                        class="category-card"
                        data-category="Mobile"
                    >

                        <span class="category-icon">
                            📱
                        </span>

                        <h3>Mobile</h3>

                        <p>
                            Smartphone accessories and mobile tech.
                        </p>

                    </button>


                    <button
                        class="category-card"
                        data-category="Gaming"
                    >

                        <span class="category-icon">
                            🎮
                        </span>

                        <h3>Gaming</h3>

                        <p>
                            Gaming accessories and equipment.
                        </p>

                    </button>


                    <button
                        class="category-card"
                        data-category="Smart Home"
                    >

                        <span class="category-icon">
                            🏠
                        </span>

                        <h3>Smart Home</h3>

                        <p>
                            Smart devices for your home.
                        </p>

                    </button>


                    <button
                        class="category-card"
                        data-category="Creator"
                    >

                        <span class="category-icon">
                            📸
                        </span>

                        <h3>Creator</h3>

                        <p>
                            Tools for content creators and creators.
                        </p>

                    </button>

                </div>

            </div>

        </section>


        <!-- ================= TRENDING PRODUCTS ================= -->

        <section
            class="products-section"
            id="trending"
        >

            <div class="container">

                <div class="section-heading section-heading-row">

                    <div>

                        <span class="eyebrow">
                            TRENDING NOW
                        </span>

                        <h2>
                            Trending Finds
                        </h2>

                        <p>
                            Tech and gadgets selected for discovery.
                        </p>

                    </div>

                    <button
                        type="button"
                        id="clearFilters"
                        class="text-button"
                    >
                        View All
                    </button>

                </div>


                <!-- Products are loaded by JavaScript -->

                <div
                    class="product-grid"
                    id="productGrid"
                >

                    <div class="loading-message">
                        Loading products...
                    </div>

                </div>


                <!-- No results -->

                <div
                    class="no-results"
                    id="noResults"
                    hidden
                >

                    <h3>
                        No products found
                    </h3>

                    <p>
                        Try another search or choose a different category.
                    </p>

                </div>

            </div>

        </section>


        <!-- ================= WHY TRENDING FINDS ================= -->

        <section class="why-section">

            <div class="container">

                <div class="section-heading">

                    <span class="eyebrow">
                        WHY TRENDING FINDS?
                    </span>

                    <h2>
                        Simple. Useful. Worth discovering.
                    </h2>

                </div>


                <div class="features-grid">

                    <article class="feature-card">

                        <span class="feature-icon">
                            🔎
                        </span>

                        <h3>
                            Easy Discovery
                        </h3>

                        <p>
                            Browse products by category or search for
                            something specific.
                        </p>

                    </article>


                    <article class="feature-card">

                        <span class="feature-icon">
                            ⚡
                        </span>

                        <h3>
                            Trending Tech
                        </h3>

                        <p>
                            Discover interesting gadgets and technology
                            worth checking out.
                        </p>

                    </article>


                    <article class="feature-card">

                        <span class="feature-icon">
                            🔗
                        </span>

                        <h3>
                            Shop on Amazon
                        </h3>

                        <p>
                            When available, product links can take you
                            directly to the relevant Amazon product page.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- ================= NEWSLETTER ================= -->

        <section class="newsletter-section">

            <div class="container newsletter-box">

                <div>

                    <span class="eyebrow">
                        STAY UPDATED
                    </span>

                    <h2>
                        Discover more trending tech.
                    </h2>

                    <p>
                        Subscribe to hear about new gadget discoveries
                        and useful tech.
                    </p>

                </div>


                <form
                    id="newsletterForm"
                    class="newsletter-form"
                >

                    <label
                        for="newsletterEmail"
                        class="visually-hidden"
                    >
                        Email address
                    </label>

                    <input
                        type="email"
                        id="newsletterEmail"
                        name="email"
                        placeholder="Your email address"
                        required
                    >

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Subscribe
                    </button>

                </form>

            </div>

        </section>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-grid">

                <!-- Brand -->

                <div class="footer-brand">

                    <a href="index.html" class="logo">
                        Trending <span>Finds</span>
                    </a>

                    <p>
                        Discover the tech and gadgets worth knowing.
                    </p>

                </div>


                <!-- Explore -->

                <div class="footer-column">

                    <h3>
                        Explore
                    </h3>

                    <a href="index.html">
                        Home
                    </a>

                    <a href="#categories">
                        Categories
                    </a>

                    <a href="#trending">
                        Trending Finds
                    </a>

                </div>


                <!-- Information -->

                <div class="footer-column">

                    <h3>
                        Information
                    </h3>

                    <a href="about.html">
                        About Us
                    </a>

                    <a href="affiliate-disclosure.html">
                        Affiliate Disclosure
                    </a>

                    <a href="privacy.html">
                        Privacy Policy
                    </a>

                    <a href="terms.html">
                        Terms & Conditions
                    </a>

                </div>


                <!-- Contact -->

                <div class="footer-column">

                    <h3>
                        Contact
                    </h3>

                    <a href="contact.html">
                        Contact Us
                    </a>

                </div>

            </div>


            <div class="footer-bottom">

                <p>
                    &copy;
                    <span id="currentYear"></span>
                    Trending Finds. All rights reserved.
                </p>

                <p>
                    As an Amazon Associate, we may earn from qualifying purchases.
                </p>

            </div>

        </div>

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="js/products.js"></script>
    <script src="js/app.js"></script>

</body>
</html>
